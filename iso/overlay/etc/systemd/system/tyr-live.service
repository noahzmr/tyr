[Unit]
Description=Tyr acceptance test (tty1)
After=systemd-user-sessions.service systemd-udev-settle.service rasdaemon.service lldpd.service
Conflicts=getty@tty1.service
Before=getty.target

[Service]
Type=idle
ExecStart=/usr/local/sbin/tyr-live
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
