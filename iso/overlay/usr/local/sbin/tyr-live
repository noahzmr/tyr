#!/bin/bash
# Tyr live: runs the acceptance test on tty1 after boot and keeps the
# verdict on screen. Kernel command line:
#   tyr.profile=burnin|quick|extended|none   (none: no automatic test)
#   tyr.peer=HOST[:PORT] tyr.token=TOKEN      network test against `tyr net-peer` (DHCP)
#   tyr.dhcp=1                                DHCP on all wired NICs without a peer
#   tyr.wait=SECONDS                          countdown before the test (default 15)
#   tyr.netbox=0                              do not write the result to NetBox
#   tyr.webhook=URL                           notify a webhook (start, failed steps, verdict);
#   tyr.webhook_format=json|slack|teams|discord|gchat  tyr.webhook_events=started,fail,…
#   tyr.webhook_token=TOKEN                   tyr.webhook=0: no notifications at all
# Results go to a partition labelled TYR-RESULTS (FAT, exFAT or ext4) when
# one is present, else to /var/lib/tyr/accept (memory: lost at reboot). The
# image itself has one (64 MB), so a stick written with dd keeps the results;
# as a virtual CD it is read-only. accept.json on it overrides the limits,
# netbox.json and tags.json the NetBox settings built into the ISO,
# webhooks.json the webhooks. TYR_WEBHOOK_* / TYR_NETBOX_* given to
# `make iso` are in /etc/tyr/tyr.env.

set -u
export TERM=${TERM:-linux}
export LANG=C.UTF-8

arg() { tr ' ' '\n' </proc/cmdline | sed -n "s/^$1=//p" | tail -1; }
profile=$(arg tyr.profile)
profile=${profile:-burnin}
peer=$(arg tyr.peer)
token=$(arg tyr.token)
wait_s=$(arg tyr.wait)
wait_s=${wait_s:-15}
nb_off=$(arg tyr.netbox)
wh=$(arg tyr.webhook)

# the build's environment, then the kernel command line
if [[ -f /etc/tyr/tyr.env ]]; then
	set -a
	# shellcheck disable=SC1091
	. /etc/tyr/tyr.env
	set +a
fi
if [[ -n $wh && $wh != 0 ]]; then
	export TYR_WEBHOOK_URL=$wh
	for k in format events token; do
		v=$(arg "tyr.webhook_$k")
		[[ -n $v ]] && export "TYR_WEBHOOK_${k^^}=$v"
	done
fi
results=/mnt/results
out=""

bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' off=$'\e[0m'

setterm --blank 0 --powerdown 0 2>/dev/null
mkdir -p "$results"

header() {
	clear
	local ip sn
	ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $2" "$4}' | paste -sd, -)
	sn=$(cat /sys/class/dmi/id/product_serial 2>/dev/null)
	echo "${bold}Tyr live$off $(tyr version 2>/dev/null | cut -d' ' -f2)  ·  $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $(cat /sys/class/dmi/id/product_name 2>/dev/null)${sn:+  ·  S/N $sn}"
	echo "${dim}Alt+F2 shell · Alt+F3 live view (tyr) · Alt+F1 back here${ip:+ · $ip}$off"
	if netbox_on; then
		local nb=${TYR_NETBOX_URL:-}
		[[ -z $nb && -f /etc/tyr/netbox.json ]] && nb=$(sed -n 's/.*"url": *"\([^"]*\)".*/\1/p' /etc/tyr/netbox.json | head -1)
		echo "${dim}NetBox: $nb - the result is written to the device after the test$off"
	fi
	if webhook_on; then
		local hooks=""
		[[ -f /etc/tyr/webhooks.json ]] && hooks=$(sed -n 's/.*"url": *"https\{0,1\}:\/\/\([^/"]*\).*/\1/p' /etc/tyr/webhooks.json | paste -sd, -)
		[[ -n ${TYR_WEBHOOK_URL:-} ]] && hooks+="${hooks:+,}$(sed 's#^https\{0,1\}://\([^/]*\).*#\1#' <<<"$TYR_WEBHOOK_URL")"
		echo "${dim}Webhooks: $hooks - notified when the test starts, a step fails or warns, and at the end$off"
	fi
	echo
}

# netbox_on: NetBox settings exist (ISO or stick) and tyr.netbox=0 is not set.
netbox_on() { [[ $nb_off != 0 && ( -f /etc/tyr/netbox.json || -n ${TYR_NETBOX_URL:-} ) ]]; }

# webhook_on: webhooks from the ISO, the stick, the build or the kernel
# command line, and tyr.webhook=0 is not set.
webhook_on() { [[ $wh != 0 && ( -f /etc/tyr/webhooks.json || -n ${TYR_WEBHOOK_URL:-} ) ]]; }

# netbox_from_stick: netbox.json / tags.json on TYR-RESULTS replace the ISO's.
netbox_from_stick() {
	mountpoint -q "$results" || return 0
	local f
	for f in netbox.json tags.json webhooks.json; do
		if [[ -f $results/$f ]]; then
			install -D -m 600 "$results/$f" "/etc/tyr/$f" && echo "settings: $f from the stick"
		fi
	done
}

# find_results mounts the TYR-RESULTS partition (waits a little: USB sticks
# enumerate late).
find_results() {
	mountpoint -q "$results" && return 0
	local dev="" i
	for i in $(seq 1 "${1:-1}"); do
		udevadm settle -t 5 2>/dev/null
		dev=$(blkid -L TYR-RESULTS 2>/dev/null) && break
		sleep 1
	done
	[[ -n $dev ]] || return 1
	if mount -o rw,noatime "$dev" "$results" 2>/dev/null; then
		echo "results: $dev (TYR-RESULTS) → $results/tyr"
		return 0
	fi
	echo "${yellow}found TYR-RESULTS on $dev but cannot mount it read-write (virtual media?)$off"
	return 1
}

network() {
	if [[ -n $peer || $(arg tyr.dhcp) == 1 ]] || netbox_on || webhook_on; then
		mkdir -p /run/systemd/network
		printf '[Match]\nType=ether\nKind=!*\n\n[Network]\nDHCP=yes\n' >/run/systemd/network/10-tyr-dhcp.network
		networkctl reload 2>/dev/null
		# DNS from DHCP through systemd-resolved
		systemctl start systemd-resolved 2>/dev/null
		[[ -L /etc/resolv.conf ]] || ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
		echo "network: DHCP on wired NICs, waiting up to 60 s …"
		/usr/lib/systemd/systemd-networkd-wait-online --any --timeout=60 >/dev/null 2>&1 || echo "${yellow}no address yet$off"
	fi
}

choose() {
	echo
	echo "  ${bold}b$off burn-in (~4 h)   ${bold}q$off quick (~30 min)   ${bold}e$off extended (~24 h)"
	echo "  ${bold}t$off Tyr TUI   ${bold}s$off shell   ${bold}r$off reboot   ${bold}p$off power off"
	local k
	read -rsn1 -p "> " k
	echo
	case "$k" in
	b) profile=burnin ;;
	q) profile=quick ;;
	e) profile=extended ;;
	t) tyr --no-smart; profile=none ;;
	s) bash -l; profile=none ;;
	r) systemctl reboot ;;
	p) systemctl poweroff ;;
	*) profile=none ;;
	esac
}

run_accept() {
	local limits=() base=/var/lib/tyr/accept
	if find_results 1; then
		base=$results/tyr
	fi
	if [[ -f $results/accept.json ]] && mountpoint -q "$results"; then
		limits=(--limits "$results/accept.json")
		echo "limits: $results/accept.json"
	elif [[ -f /etc/tyr/accept.json ]]; then
		limits=(--limits /etc/tyr/accept.json)
		echo "limits: /etc/tyr/accept.json (built into the ISO)"
	fi
	mkdir -p "$base"
	local log=$base/console-$(date -u +%Y%m%dT%H%M%SZ).log
	local cmd=(tyr accept --profile "$profile" --yes --out "$base" "${limits[@]}")
	[[ -n $peer ]] && cmd+=(--peer "$peer" --token "$token")
	if netbox_on; then
		cmd+=(--netbox)
	else
		cmd+=(--no-netbox)
	fi
	webhook_on || cmd+=(--no-webhook)
	# script keeps a terminal for tyr (colours, banner) and logs the console
	script -qfec "$(printf '%q ' "${cmd[@]}")" "$log"
	rc=$?
	out=$(ls -1dt "$base"/*/ 2>/dev/null | head -1)
	[[ -n $out ]] && mv "$log" "$out/console.log" 2>/dev/null
	sync
	return $rc
}

after() {
	while true; do
		echo
		[[ -n $out ]] && echo "${dim}results: $out$off"
		if ! mountpoint -q "$results"; then
			echo "${yellow}No TYR-RESULTS stick: the results are in memory only. Plug one in and press c to copy them.$off"
		fi
		echo "  ${bold}v$off view report   ${bold}c$off copy to TYR-RESULTS   ${bold}t$off Tyr TUI   ${bold}s$off shell   ${bold}a$off run again   ${bold}r$off reboot   ${bold}p$off power off"
		local k
		read -rsn1 -p "> " k
		echo
		case "$k" in
		v) [[ -n $out ]] && tyr view "$out/accept.md" ;;
		c)
			if [[ -z $out ]]; then
				echo "${yellow}no results to copy$off"
			elif [[ $out == "$results"/* ]]; then
				echo "already on TYR-RESULTS: $out"
			elif ! find_results 10; then
				echo "${red}no partition labelled TYR-RESULTS found (blkid -L TYR-RESULTS).$off"
				echo "Plug in a stick with one (sudo mkfs.vfat -n TYR-RESULTS /dev/sdX1) and press c again."
			elif mkdir -p "$results/tyr" && cp -r "${out%/}" "$results/tyr/" && sync; then
				out=$results/tyr/$(basename "$out")
				echo "${green}copied to $out$off"
			else
				echo "${red}copy to $results/tyr failed (full or read-only?)$off"
			fi
			;;
		t) tyr --no-smart ;;
		s) bash -l ;;
		a) return 0 ;;
		r) systemctl reboot ;;
		p) systemctl poweroff ;;
		esac
	done
}

while true; do
	header
	find_results 15 && netbox_from_stick
	mountpoint -q "$results" || echo "${yellow}no writable TYR-RESULTS partition: the results stay in memory. Plug in a stick with a partition labelled TYR-RESULTS to keep them.$off"
	network
	if [[ $profile != none ]]; then
		echo
		echo "Starting the ${bold}$profile$off acceptance test in $wait_s s - press any key for the menu."
		if read -rsn1 -t "$wait_s"; then
			choose
		fi
	else
		choose
	fi
	[[ $profile == none ]] && continue
	header
	run_accept
	after
done
